<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.opencode.ide</groupId>
  <artifactId>com.opencode.ide.parent</artifactId>
  <version>0.1.11-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>OpenCode IDE - Parent</name>
  <description>Eclipse plugin integrating opencode. Parent/reactor POM (Tycho).</description>

  <properties>
    <tycho.version>5.0.3</tycho.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <modules>
    <module>releng/opencode-eclipse.target</module>
    <module>bundles/com.opencode.ide.core</module>
    <module>bundles/com.opencode.ide.core.tests</module>
    <module>bundles/com.opencode.ide.client</module>
    <module>bundles/com.opencode.ide.client.tests</module>
    <module>bundles/com.opencode.ide.ui</module>
    <module>bundles/com.opencode.ide.ui.tests</module>
    <module>bundles/com.opencode.ide.chat</module>
    <module>bundles/com.opencode.ide.chat.tests</module>
    <module>bundles/com.opencode.ide.cdt</module>
    <module>bundles/com.opencode.ide.cdt.tests</module>
    <module>bundles/com.opencode.ide.git</module>
    <module>bundles/com.opencode.ide.git.tests</module>
    <module>bundles/com.opencode.ide.fleet</module>
    <module>bundles/com.opencode.ide.fleet.tests</module>
    <module>bundles/com.opencode.ide.tools</module>
    <module>bundles/com.opencode.ide.tools.tests</module>
    <module>bundles/com.opencode.ide.tasks</module>
    <module>bundles/com.opencode.ide.tasks.tests</module>
    <module>bundles/com.opencode.ide.board</module>
    <module>bundles/com.opencode.ide.board.tests</module>
    <module>bundles/com.opencode.ide.mcp</module>
    <module>bundles/com.opencode.ide.mcp.tests</module>
    <module>mojo/opencode-tasks</module>
<module>bundles/com.opencode.ide.arch.tests</module>
    <module>features/com.opencode.ide.feature</module>
    <module>releng/com.opencode.ide.repository</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <target>
            <file>${maven.multiModuleProjectDirectory}/releng/opencode-eclipse.target/opencode-eclipse.target</file>
          </target>
          <executionEnvironment>JavaSE-21</executionEnvironment>
          <pomDependencies>consider</pomDependencies>
          <environments>
            <environment>
              <os>win32</os><ws>win32</ws><arch>x86_64</arch>
            </environment>
            <environment>
              <os>linux</os><ws>gtk</ws><arch>x86_64</arch>
            </environment>
            <environment>
              <os>macosx</os><ws>cocoa</ws><arch>x86_64</arch>
            </environment>
          </environments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/releng/checkstyle.xml</configLocation>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>error</violationSeverity>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
        </configuration>
        <dependencies>
          <!-- the plugin bundles checkstyle 9.3, whose parser predates Java
               21 records/patterns - run the modern engine instead -->
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>10.17.0</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>checkstyle-lint</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>check-architecture</id>
            <!-- once per reactor (QUALITY.md): the script scans the whole tree -->
            <inherited>false</inherited>
            <phase>validate</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>pwsh</executable>
              <arguments>
                <argument>-NoProfile</argument>
                <argument>-File</argument>
                <argument>${maven.multiModuleProjectDirectory}/releng/check-architecture.ps1</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- U-085 coverage lane (code-quality-matrix: Java/Coverage): report-only,
           no threshold - the report is the refactor safety net -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <!-- default property name argLine: surefire picks it up at fork
                   time and tycho-surefire gets it via ${argLine} below. NEVER
                   declare it in <properties> - a pom property bakes ${...} to
                   empty at model interpolation, before prepare-agent can set it -->
              <destFile>${project.build.directory}/jacoco.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- U-087 format lane (code-quality-matrix: Java/Format): the one
           formatter, applied once and locked by spotless:check at verify -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.28.0</version>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-compiler-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <release>21</release>
            <compilerArgs>
              <arg>-warn:-fieldHiding</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-packaging-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <strictBinIncludes>false</strictBinIncludes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-surefire-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <!-- JaCoCo agent into the forked OSGi test JVM (U-085): under Tycho
                 prepare-agent sets tycho.testArgLine (not argLine) - resolved at
                 mojo injection, deliberately NOT declared in <properties> -->
            <argLine>${tycho.testArgLine}</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      The deeper quality gate (QUALITY.md): `verify -Pquality` adds bug-pattern
      and duplication scans on top of the always-on checkstyle + architecture
      checks. SpotBugs is report-only (failOnError=false: findings print, the
      build stays green); PMD CPD (cpd-check, >=100 tokens) fails the build on
      duplication findings.
    -->
    <profile>
      <id>quality</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>4.9.3.0</version>
            <configuration>
              <effort>Max</effort>
              <threshold>High</threshold>
              <failOnError>false</failOnError>
              <xmlOutput>true</xmlOutput>
            </configuration>
            <executions>
              <execution>
                <id>spotbugs-scan</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <version>3.26.0</version>
            <configuration>
              <linkXRef>false</linkXRef>
              <printFailingErrors>true</printFailingErrors>
              <minimumTokens>100</minimumTokens>
            </configuration>
            <executions>
              <execution>
                <id>cpd-duplication</id>
                <phase>verify</phase>
                <goals>
                  <goal>cpd-check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- U-088 coverage gate (opt-in, `-Pcoverage`; QUALITY.md table): adds a
         threshold check and a reactor-wide aggregate report on top of the
         always-on report-only lane (U-085). jacoco has no aggregate check
         goal, so the pieces bind where they are actually expressible:
         - check runs per module at BUNDLE scope (55% covered lines, build
           fails below). jacoco SKIPS a module whose own exec file is absent -
           every production Tycho bundle is exec-less (its tests execute in
           the *.tests fragment, whose forked OSGi JVM carries the agent), so
           a per-bundle threshold on those bundles is not expressible at all.
           The rule therefore binds where in-module test execution meets
           production-only classes: the mojo plugin (plain surefire,
           target/classes only). The include is deliberately the mojo package,
           NOT com/opencode/ide/**: the test fragments' own classes share the
           production packages (com.opencode.ide.tools.tests hosts classes in
           com.opencode.ide.tools; arch.tests carries never-executed probe
           fixtures), so a broad include would measure test code against the
           threshold. Production-bundle coverage is measured by the aggregate
           report below, which reads the fragments' full-run exec data.
         - report-aggregate is root-only (inherited=false). The parent builds
           FIRST in the reactor, so within one clean run the aggregate sees no
           exec data yet (empty report, non-failing); on an already-built
           tree - the normal gate flow - the exec files are present and the
           report is complete. A dedicated last-position report module is the
           same-run-complete alternative; deliberately out of scope here. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.15</version>
            <executions>
              <execution>
                <id>report-aggregate</id>
                <inherited>false</inherited>
                <phase>verify</phase>
                <goals>
                  <goal>report-aggregate</goal>
                </goals>
                <configuration>
                  <dataFileIncludes>
                    <dataFileInclude>**/target/jacoco.exec</dataFileInclude>
                  </dataFileIncludes>
                  <outputDirectory>${maven.multiModuleProjectDirectory}/target/site/jacoco-aggregate</outputDirectory>
                </configuration>
              </execution>
              <execution>
                <id>coverage-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>com/opencode/ide/mojo/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.55</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- U-089 optional cells (owner: "make them optional") - opt-in profiles,
         never part of plain verify or CI. The licenses cell lives in
         releng/scan-deps.ps1 (-Licenses): the matrix's cited
         license-maven-plugin goal (aggregate-add-third-party) was removed from
         every maintained mycila version (4.6/5.1.2 expose only
         check/format/help/remove), so the cell goes to osv-scanner's
         license mode - free, reliable, already pinned here (the matrix's
         selection bar, applied to a stale tool citation). -->

    <!-- Error Prone (matrix Java/Static): the plugin jar rides the compile
         CLASSPATH as a provided-scope project dependency (-Xplugin:ErrorProne
         discovers plugins on javac's classpath, NOT on the maven-compiler
         plugin realm - the "Plug-in nicht gefunden" lesson), so plain-javac
         modules pick it up through their existing default-compile binding
         while the Tycho modules (ECJ) never run it - that is the documented
         scope limit, not a contradiction. provided = compiled-against,
         packaged nowhere. The JDK module exports come from
         eclipse/.mvn/jvm.config (in-process javac, no fork). -->
    <profile>
      <id>errorprone</id>
      <dependencies>
        <dependency>
          <groupId>com.google.errorprone</groupId>
          <artifactId>error_prone_core</artifactId>
          <version>2.50.0</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
            <configuration>
              <compilerArgs>
                <!-- Error Prone's required javac flags, each learned from its own
                     error message: policy pair + the JDK 21 type-annotation symbol -->
                <arg>-XDcompilePolicy=simple</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                <arg>-Xplugin:ErrorProne</arg>
              </compilerArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
