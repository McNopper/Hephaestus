<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.opencode.ide</groupId>
    <artifactId>com.opencode.ide.parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>com.opencode.ide.client</artifactId>
  <packaging>eclipse-plugin</packaging>

  <build>
    <plugins>
      <!-- Keep this bundle platform-free (reusable as a plain library): the
           pwsh scan fails the build on any org.eclipse. / org.osgi. reference
           under src/main/java, on every OS (skip only with -DskipEclipseBan=true).
           ONE allowlist since 2026-09-23 (user direction: "we chose Eclipse
           because we do not reinvent everything from scratch ... hello, use
           [the JobManager]"): the JobManager runtime - org.eclipse.core.runtime.jobs.*
           plus IProgressMonitor/IStatus/Status - is permitted. Both live in
           org.eclipse.core.jobs + org.eclipse.equinox.common, which run in a
           PLAIN JVM (proven by a standalone smoke test), so the reusable-as-a-
           plain-library purpose of this check is preserved: WorkerPools is a
           thin JobGroup bridge, never a thread pool of our own. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>ban-eclipse-imports</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pwsh</executable>
              <arguments>
                <argument>-NoProfile</argument>
                <argument>-NonInteractive</argument>
                <argument>-Command</argument>
                <argument>$allow = 'org\.eclipse\.core\.runtime\.jobs\.|org\.eclipse\.core\.runtime\.(IProgressMonitor|IStatus|Status);'; $hits = Get-ChildItem 'src/main/java' -Recurse -Filter *.java | Select-String -Pattern 'org\.eclipse\.|org\.osgi\.' | Where-Object { $_.Line -notmatch $allow }; if ($hits) { $hits | ForEach-Object { Write-Host ('FAIL {0}:{1}: {2}' -f $_.Path, $_.LineNumber, $_.Line.Trim()) }; exit 1 }; Write-Host 'client bundle is platform-free except the JobManager runtime'</argument>
              </arguments>
              <skip>${skipEclipseBan}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <properties>
    <skipEclipseBan>false</skipEclipseBan>
  </properties>
</project>
