<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.opencode.ide</groupId>
    <artifactId>com.opencode.ide.parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>com.opencode.ide.client.tests</artifactId>
  <packaging>eclipse-test-plugin</packaging>

  <!-- T-008 plain test lane: Eclipse-free bundle, tests run on plain
       maven-surefire instead of the tycho-surefire OSGi boot; packaging stays
       eclipse-test-plugin (target-platform compile fidelity). `-Posgi-parity`
       flips both switches back for the weekly OSGi-parity run. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- JUnit4 provider FORCED: the junit jar arrives as a Tycho p2
             artifact whose coordinates miss surefire's auto-detection (it fell
             back to JUnit3 = 0 tests, caught by failIfNoTests). Plugin
             dependencies never enter the target platform. -->
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit4</artifactId>
            <version>3.2.5</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>plain-lane-test</id>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- rubberduck landmine (T-008): tests live in src/main/java and
               compile to target/classes - without this, plain surefire finds
               target/test-classes (empty) and silently discovers ZERO tests -->
          <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
          <failIfNoTests>true</failIfNoTests>
          <skipTests>${plainLane.skipSurefire}</skipTests>
          <!-- jacoco prepare-agent sees tycho-surefire declared here and sets
               tycho.testArgLine (not argLine) - the plain fork must be handed
               the same agent string or coverage silently drops to exec-less -->
          <argLine>${tycho.testArgLine}</argLine>
          <!-- same fork environment as the tycho-surefire OSGi run: reply
               polling and the quiet window at test speed (ClientTuning keeps
               the production defaults) -->
          <environmentVariables>
            <CLIENT_REPLY_POLL_MS>25</CLIENT_REPLY_POLL_MS>
            <CLIENT_TURN_QUIET_MS>250</CLIENT_TURN_QUIET_MS>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${plainLane.skipTychoSurefire}</skipTests>
          <!-- test-speed knobs: reply polling and the marker-less quiet window
               run at test speed here; production defaults stay in ClientTuning
               (the tests pin semantics, not wall-clock) -->
          <environmentVariables>
            <CLIENT_REPLY_POLL_MS>25</CLIENT_REPLY_POLL_MS>
            <CLIENT_TURN_QUIET_MS>250</CLIENT_TURN_QUIET_MS>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
