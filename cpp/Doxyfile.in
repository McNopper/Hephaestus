# ============================================================
# Doxyfile.in
# AI-first Doxygen configuration for C++23 projects
#
# This file is configured by CMake:
#   configure_file(Doxyfile.in ${CMAKE_BINARY_DIR}/Doxyfile @ONLY)
# ============================================================

# ============================================================
# Project
# ============================================================

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "AI-first C++23 project documentation and dependency map"

OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"

CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

# ============================================================
# Input
# ============================================================

INPUT                  = "@CMAKE_SOURCE_DIR@/include" \
                         "@CMAKE_SOURCE_DIR@/src" \
                         "@CMAKE_SOURCE_DIR@/tests"

RECURSIVE              = YES

FILE_PATTERNS          = *.h \
                         *.hh \
                         *.hpp \
                         *.hxx \
                         *.c \
                         *.cc \
                         *.cpp \
                         *.cxx \
                         *.ixx \
                         *.cppm

EXCLUDE                = "@CMAKE_SOURCE_DIR@/build" \
                         "@CMAKE_SOURCE_DIR@/cmake-build-debug" \
                         "@CMAKE_SOURCE_DIR@/cmake-build-release" \
                         "@CMAKE_SOURCE_DIR@/_deps" \
                         "@CMAKE_SOURCE_DIR@/external" \
                         "@CMAKE_SOURCE_DIR@/third_party"

EXCLUDE_PATTERNS       = */build/* \
                         */cmake-build-*/* \
                         */_deps/* \
                         */external/* \
                         */third_party/* \
                         */.git/*

# ============================================================
# Extraction
# ============================================================
# AI-friendly mode: extract as much structure as possible,
# including undocumented code.

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = YES

# ============================================================
# Source browsing / cross references
# ============================================================
# Useful for AI/code tools because generated HTML keeps source
# context and links between symbols.

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
USE_HTAGS              = NO
VERBATIM_HEADERS       = YES

# ============================================================
# C++ / parsing behavior
# ============================================================

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO

BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = NO
DISTRIBUTE_GROUP_DOC   = NO
GROUP_NESTED_COMPOUNDS = YES
SUBGROUPING            = YES

# ============================================================
# Preprocessor
# ============================================================
# Keep preprocessing on so macros/includes are resolved as far
# as possible for dependency extraction.

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = "@CMAKE_SOURCE_DIR@/include"
INCLUDE_FILE_PATTERNS  = *.h \
                         *.hh \
                         *.hpp \
                         *.hxx

SKIP_FUNCTION_MACROS   = NO

# ============================================================
# Clang-assisted parsing
# ============================================================
# This is important for AI-oriented dependency resolution.
# It lets Doxygen use Clang/libclang-style parsing and the
# CMake compile_commands.json database.
#
# Requires:
#   set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
#
# Your CMakeLists.txt already enables this.

CLANG_ASSISTED_PARSING = YES
CLANG_DATABASE_PATH    = "@CMAKE_BINARY_DIR@"

# Additional parser flags. Keep these conservative.
CLANG_OPTIONS          = -std=c++23 \
                         -I"@CMAKE_SOURCE_DIR@/include"

CLANG_ADD_INC_PATHS    = YES

# ============================================================
# HTML output
# ============================================================

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# ============================================================
# XML output
# ============================================================
# Strongly recommended for AI/tools.
# XML is easier for scripts, agents, and indexers to consume
# than HTML.

GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES
XML_NS_MEMB_FILE_SCOPE = YES

# Compact symbol cross-reference index. Useful for agents and for linking
# other Doxygen runs against this project.
GENERATE_TAGFILE       = "@CMAKE_BINARY_DIR@/docs/@PROJECT_NAME@.tag"

# ============================================================
# Other output formats
# ============================================================

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_PERLMOD       = NO

# ============================================================
# Graphviz / dependency graphs
# ============================================================
# Doxygen uses Graphviz dot when HAVE_DOT=YES for advanced graphs.
# This enables include graphs, reverse include graphs, call graphs,
# caller graphs, class graphs, collaboration graphs, and directory
# dependency graphs.

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = YES

INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

DIR_GRAPH_MAX_DEPTH    = 5
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 4
DOT_MULTI_TARGETS      = YES
DOT_NUM_THREADS        = 0
DOT_CLEANUP            = YES

# ============================================================
# Warnings
# ============================================================
# For AI/refactoring, warnings are useful because they reveal
# unresolved symbols, broken links, undocumented params, etc.
# Keep WARN_AS_ERROR off initially so documentation still builds.

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = "@CMAKE_BINARY_DIR@/docs/doxygen_warnings.log"

# ============================================================
# Indexes and navigation
# ============================================================

ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 5
IGNORE_PREFIX          =

GENERATE_DEPRECATEDLIST = YES
GENERATE_TODOLIST       = YES
GENERATE_TESTLIST       = YES
GENERATE_BUGLIST        = YES

# ============================================================
# Sorting
# ============================================================

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = YES
SORT_BY_SCOPE_NAME     = YES

# ============================================================
# Markdown
# ============================================================

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
AUTOLINK_SUPPORT       = YES

# ============================================================
# Paths
# ============================================================

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@CMAKE_SOURCE_DIR@/include"

# ============================================================
# Misc
# ============================================================

LOOKUP_CACHE_SIZE      = 2
NUM_PROC_THREADS       = 0